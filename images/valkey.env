# valkey: upstream's valkey:9.1.4-alpine3.24 (UPSTREAM_IMAGE, pinned by digest) with `apk upgrade`, for media-redis
# (cache and queue). Trivy passes 9.1.4 already; grype wants OpenSSL -r1 and zlib 1.4-r0, both in Alpine 3.24 main.
# valkey, tini, the entrypoint and every setting are upstream's.
# WATCH_ACTION=retire: when upstream publishes a newer 9.1.x release (UPSTREAM_TAG_PREFIX), the weekly upstream-watch
# asks for a scan of upstream's image of it; if it passes the gate (docker-library rebuilt on Alpine 3.24.5 or later),
# consumers pin upstream's image again and this recipe is deleted.
# Bump FC_REVISION to publish a new build of the same upstream tag; an existing tag is never overwritten.
APP_NAME=valkey
IMAGE=ghcr.io/figurecollecting/valkey
DOCKERFILE=Dockerfile.valkey
SMOKE=valkey
WATCH_ACTION=retire
DOCS_URL=https://valkey.io/topics/
UPSTREAM_REPO=https://github.com/valkey-io/valkey
UPSTREAM_TAG=9.1.4
UPSTREAM_TAG_PREFIX=9.1.
UPSTREAM_IMAGE=docker.io/valkey/valkey:9.1.4-alpine3.24@sha256:56729e68bdda139cbd3f6a2538683dc3523325fc5711ea1a379938f1b37893f0
FC_REVISION=fc1
