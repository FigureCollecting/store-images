# VictoriaTraces v0.13.0 (built by upstream with Go UPSTREAM_GO_VERSION and klauspost/compress v1.20.1) rebuilt
# with two changes: Go GO_VERSION (CVE-2026-97054, fixed in 1.27.4) and UPSTREAM_PATCH_MODULE moved to
# UPSTREAM_PATCH_VERSION (CVE-2026-116591, fixed in v1.20.2; v1.20.4 is the current release and the version
# VictoriaLogs v1.54.0 ships). Upstream has neither change on master yet (2026-11-20).
# UPSTREAM_IMAGE is upstream's own image of the tag: the build checks that our binary differs from its binary
# only in the Go version and that one module.
# Bump FC_REVISION to publish a new build of the same upstream tag; an existing tag is never overwritten.
APP_NAME=victoria-traces
IMAGE=ghcr.io/figurecollecting/victoria-traces
HTTP_PORT=10428
DOCS_URL=https://docs.victoriametrics.com/victoriatraces/
UPSTREAM_REPO=https://github.com/VictoriaMetrics/VictoriaTraces
UPSTREAM_TAG=v0.13.0
UPSTREAM_COMMIT=f0295d1f796d2c7880ee2fdaf899d0ba754f4d8a
UPSTREAM_DESCRIBE=tags-v0.13.0-0-gf0295d1f7
UPSTREAM_IMAGE=docker.io/victoriametrics/victoria-traces:v0.13.0@sha256:3018df8f99429d7d3029167ab9f70848bf0a778c31c49dff16c86c7e34759fbd
UPSTREAM_GO_VERSION=1.27.3
UPSTREAM_PATCH_MODULE=github.com/klauspost/compress
UPSTREAM_PATCH_VERSION=v1.20.4
GO_VERSION=1.27.4
FC_REVISION=fc1
