# Grafana OSS v13.3.1 for the internal log and trace viewer: upstream's image (pinned by digest in
# Dockerfile.grafana) with the VictoriaLogs data source baked in, the bundled data sources we do not use
# removed, and telemetry, update checks and run-time plugin installs off by default.
# All three rebuilt binaries use Go GO_VERSION, the current patch release (upstream's server used
# UPSTREAM_GO_VERSION). The backends of the two data sources are rebuilt from their release tags with the
# dependency fixes upstream has on main but has not released:
#   Jaeger v13.0.8 (reads VictoriaTraces' /select/jaeger): golang.org/x/net v0.62.0 (upstream cb0d47d1);
#   VictoriaLogs v0.34.0: golang.org/x/net v0.62.0 (upstream 2d682142) and klauspost/compress v1.20.4
#   (upstream 12c4778f).
# Grafana's own server binary is rebuilt from the public v13.3.1 tag with ONE change, UPSTREAM_PATCH_MODULE
# at UPSTREAM_PATCH_VERSION (upstream f9eeaa2a on release-13.3.2), with upstream's build settings. Drop
# that rebuild when the recipe moves to a Grafana release that ships the module at that version or later;
# scripts/upstream_watch.py says so when it sees one.
# The *_BUILD_TIME and UPSTREAM_BUILD_STAMP values are the ones upstream's release binaries carry. They are
# fixed here, not taken from the clock, so that two builds of one commit give the same image.
# Bump FC_REVISION to publish a new build of the same upstream tag; an existing tag is never overwritten.
APP_NAME=grafana
IMAGE=ghcr.io/figurecollecting/grafana
DOCKERFILE=Dockerfile.grafana
SMOKE=grafana
HTTP_PORT=3000
WATCH_ACTION=rebuild
DOCS_URL=https://grafana.com/docs/grafana/latest/
UPSTREAM_REPO=https://github.com/grafana/grafana
UPSTREAM_TAG=v13.3.1
UPSTREAM_COMMIT=5db6ba887630c7fa12e5bfd063f2fa854025468c
UPSTREAM_BUILD_STAMP=1794326153
UPSTREAM_GO_VERSION=1.27.3
UPSTREAM_PATCH_MODULE=github.com/apache/thrift
UPSTREAM_PATCH_VERSION=v0.25.0
UPSTREAM_FIX_COMMIT=f9eeaa2afe63450a135b2afc253452938a47a21c
VLOGS_DS_REPO=https://github.com/VictoriaMetrics/victorialogs-datasource
VLOGS_DS_TAG=v0.34.0
VLOGS_DS_COMMIT=a5450dee43595fd480c52dd362ced1d7430ab36b
VLOGS_DS_FIX_COMMIT=2d68214210cfdbd0842c3f6d16d90063e45799e9
VLOGS_DS_BUILD_TIME=1793964184362
JAEGER_DS_REPO=https://github.com/grafana/grafana-jaeger-datasource
JAEGER_DS_TAG=v13.0.8
JAEGER_DS_COMMIT=7bf6c164d58b6e5d6793ac35957f4cd4d2a9236d
JAEGER_DS_FIX_COMMIT=cb0d47d10adfb123be00b67ba4a7ba9fd3013ca8
JAEGER_DS_BUILD_TIME=1793646582109
GO_VERSION=1.27.4
XNET_VERSION=v0.62.0
COMPRESS_VERSION=v1.20.4
FC_REVISION=fc1
