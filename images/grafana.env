# Grafana OSS v13.3.2 for the internal log and trace viewer: upstream's image (pinned by digest in
# Dockerfile.grafana) with the VictoriaLogs data source baked in, the bundled data sources we do not use
# removed, and telemetry, update checks and run-time plugin installs off by default.
# The two rebuilt binaries use Go GO_VERSION. The backends of the two data sources are rebuilt from their
# release tags with the dependency fixes upstream has on main but has not released:
#   Jaeger v13.0.8 (reads VictoriaTraces' /select/jaeger): golang.org/x/net v0.62.0 (upstream cb0d47d1);
#   VictoriaLogs v0.34.0: golang.org/x/net v0.62.0 (upstream 2d682142) and klauspost/compress v1.20.4
#   (upstream 12c4778f).
# Grafana's own server binary is upstream's, unchanged. The build fails unless it reports UPSTREAM_TAG,
# UPSTREAM_BUILD_COMMIT and UPSTREAM_BUILD_BRANCH (upstream builds its release binaries from a private
# "#patched" branch; UPSTREAM_COMMIT is the public tag's commit) and was built by UPSTREAM_GO_VERSION with
# UPSTREAM_FIXED_MODULE at UPSTREAM_FIXED_VERSION. Earlier fc builds rebuilt the server only to get that
# module version; 13.3.2 ships it.
# The *_BUILD_TIME values are the ones upstream's release binaries carry. They are fixed here, not taken
# from the clock, so that two builds of one commit give the same image.
# Bump FC_REVISION to publish a new build of the same upstream tag; an existing tag is never overwritten.
APP_NAME=grafana
IMAGE=ghcr.io/figurecollecting/grafana
DOCKERFILE=Dockerfile.grafana
SMOKE=grafana
HTTP_PORT=3000
WATCH_ACTION=rebuild
DOCS_URL=https://grafana.com/docs/grafana/latest/
UPSTREAM_REPO=https://github.com/grafana/grafana
UPSTREAM_TAG=v13.3.2
UPSTREAM_COMMIT=b8e90ef2a99c8629339e7233a7a813456d87c075
UPSTREAM_BUILD_COMMIT=bd754986872f554d30a147ebd605a7fe15881a28
UPSTREAM_BUILD_BRANCH=release-13.3.2#patched
UPSTREAM_GO_VERSION=1.27.4
UPSTREAM_FIXED_MODULE=github.com/apache/thrift
UPSTREAM_FIXED_VERSION=v0.25.0
VLOGS_DS_REPO=https://github.com/VictoriaMetrics/victorialogs-datasource
VLOGS_DS_TAG=v0.34.0
VLOGS_DS_COMMIT=a5450dee43595fd480c52dd362ced1d7430ab36b
VLOGS_DS_FIX_COMMIT=2d68214210cfdbd0842c3f6d16d90063e45799e9
VLOGS_DS_BUILD_TIME=1793964184362
JAEGER_DS_REPO=https://github.com/grafana/grafana-jaeger-datasource
JAEGER_DS_TAG=v13.0.8
JAEGER_DS_COMMIT=7bf6c164d58b6e5d6793ac35957f4cd4d2a9236d
JAEGER_DS_FIX_COMMIT=cb0d47d10adfb123be00b67ba4a7ba9fd3013ca8
JAEGER_DS_BUILD_TIME=1793646582109
GO_VERSION=1.27.4
XNET_VERSION=v0.62.0
COMPRESS_VERSION=v1.20.4
FC_REVISION=fc1
